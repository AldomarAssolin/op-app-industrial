# Modelo para preencher diretamente no ambiente do serviço App do EasyPanel.
# Não versionar a cópia preenchida. Não usar valores de desenvolvimento.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=industrial.manexlabs.dev,127.0.0.1,localhost
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_HOST=
DB_PORT=5432
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
# Comecar com 3600 somente apos validar HTTPS; 0 mantem HSTS desativado.
DJANGO_SECURE_HSTS_SECONDS=0
# Habilitar SOMENTE após verificar proxy, isolamento e cabeçalhos encaminhados.
DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_CSRF_TRUSTED_ORIGINS=
WEB_CONCURRENCY=2

# Habilitar após aprovar os textos públicos e escolher o e-mail a ser divulgado.
OP_APP_PUBLIC_PAGES_ENABLED=False
OP_APP_SUPPORT_EMAIL=

# Habilitar depois de migrar a página inicial do OAuth para /integracoes/backup/.
# Independente do contato e da habilitação das páginas da integração acima.
OP_APP_PRODUCT_HOME_ENABLED=False
